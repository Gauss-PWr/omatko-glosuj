---
import { actions } from "astro:actions";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import logo from "../../assets/logo.webp";

const result = Astro.getActionResult(actions.login);
if (result && !result.error) return Astro.redirect("/");
const error = result?.error?.message;
---

<Layout title="Logowanie · OMatKo!!!">
  <main class="relative flex min-h-dvh items-center justify-center p-6">
    <section class="theme-surface w-full max-w-md p-8">
      <div class="mb-8 flex flex-col items-center text-center">
        <Image
          src={logo}
          alt="Logo OMatKo"
          width={320}
          class="h-auto w-64 max-w-full"
          loading="eager"
        />
        <p class="mt-5 text-lg font-bold text-o-blue">XIII OMatKo!!! · 2026</p>
        <h1 class="text-2xl font-bold">Głosowanie</h1>
        <p class="mt-1 text-sm text-[color:var(--muted-ink)]">
          Ogólnopolska Matematyczna Konferencja Studentów
        </p>
      </div>

      <form method="POST" action={actions.login} class="space-y-5">
        <label class="block">
          <span class="mb-2 block text-sm font-semibold text-[color:var(--ink)]">
            Kod z identyfikatora
          </span>
          <input
            type="text"
            name="code"
            inputmode="text"
            autocomplete="one-time-code"
            maxlength="6"
            minlength="6"
            required
            spellcheck="false"
            placeholder="••••••"
            class="w-full rounded-xl border border-[color:var(--line)] bg-white px-4 py-3 font-mono text-center text-2xl tracking-[0.4em] text-[color:var(--ink)] outline-none transition placeholder:tracking-[0.4em] placeholder:text-o-gray focus:border-o-blue focus:ring-4 focus:ring-o-blue/25 dark:bg-zinc-950"
          />
        </label>

        {error && (
          <p
            class="rounded-lg bg-o-orange/15 px-3 py-2 text-sm font-medium text-orange-800 dark:text-orange-200"
            role="alert"
          >
            {error}
          </p>
        )}

        <button
          type="submit"
          class="w-full rounded-[15px] bg-o-green px-4 py-3 text-base font-semibold text-white transition hover:brightness-95 active:translate-y-px"
        >
          Zaloguj się
        </button>
      </form>
    </section>
  </main>
</Layout>
