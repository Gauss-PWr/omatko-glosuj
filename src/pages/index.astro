---
import { authService } from "$lib/server";
import { loadSchedule } from "$lib/server/schedule";
import Layout from "../layouts/Layout.astro";
import SlotTile from "../components/SlotTile.astro";
import PresentationTile from "../components/PresentationTile.astro";
import BottomNav from "../components/BottomNav.svelte";
import OptionsPanel from "../components/OptionsPanel.astro";
import FilterBar from "../components/FilterBar.svelte";
import { buildNavigationItems } from "$lib/navigation";

const token = Astro.cookies.get("omatko-token")?.value;
const auth = token ? await authService.auth(token) : undefined;

if (!auth?.ok) return Astro.redirect("/login");
const { role } = auth.value;
const { days, posters } = await loadSchedule();

const now = Date.now();
const liveDay = days.findIndex((day) =>
  day.slots.some(
    (slot) => slot.start.getTime() <= now && now < slot.end.getTime(),
  ),
);
const navItems = buildNavigationItems(days.length, posters.length > 0);
const requestedPanel = Astro.url.searchParams.get("panel");
const initialPanel = navItems.some((item) => item.id === requestedPanel)
  ? requestedPanel!
  : liveDay >= 0
    ? `day-${liveDay}`
    : days.length > 0
      ? "day-0"
      : posters.length > 0
        ? "poster"
        : "options";
---

<Layout ballot={initialPanel}>
  <main class="relative mx-auto max-w-3xl px-4 pb-28 pt-6 sm:pt-8">
    <FilterBar client:load />
    {days.length === 0 && posters.length === 0 && (
      <p class="theme-surface p-6 text-sm text-[color:var(--muted-ink)]">
        Brak referatów. Uruchom <code class="font-mono">bun db:seed</code>.
      </p>
    )}

    {days.map((day, index) => (
      <section class={`ballot-panel panel-day-${index} flex-col gap-4`}>
        {day.slots.map((slot) => (
          <SlotTile slotCard={slot} showStats={role !== "attendee"} />
        ))}
      </section>
    ))}

    {posters.length > 0 && (
      <section class="ballot-panel panel-posters flex-col gap-4">
        {posters.map((talk) => (
          <PresentationTile
            kind="poster"
            {talk}
            showStats={role !== "attendee"}
          />
        ))}
      </section>
    )}

    <section class="ballot-panel panel-options flex-col gap-4">
      <OptionsPanel canViewStats={role !== "attendee"} />
    </section>
  </main>
  <BottomNav client:load items={navItems} initial={initialPanel} />
</Layout>
