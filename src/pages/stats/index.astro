---
import type { Category } from "$lib/domain/vote";
import { url } from "$lib/url";
import type { StatsGroup } from "$lib/server/services/stats";
import { authorizeStats } from "$lib/server/stats-access";
import { statsService } from "$lib/server";
import Layout from "../../layouts/Layout.astro";

const access = await authorizeStats(Astro.cookies.get("omatko-token")?.value);
if (!access.authorized) {
  return Astro.redirect(url(access.status === 401 ? "/login" : "/"));
}

const stats = await statsService.getOverview();

const groupLabel: Record<StatsGroup, string> = {
  applied: "Matematyka stosowana",
  theory: "Matematyka teoretyczna",
  poster: "Plakaty",
};

function categoryLabel(category: Category): string {
  switch (category) {
    case "t_1":
    case "p_1":
      return "Merytoryka";
    case "t_2":
      return "Forma";
    case "p_2":
      return "Estetyka";
  }
}

function number(value: number): string {
  return value.toLocaleString("pl-PL");
}
---

<Layout title="Statystyki głosowania · OMatKo!!!">
  <main class="mx-auto max-w-5xl px-4 pb-12 pt-6 sm:pt-8">
    <a
      class="inline-flex min-h-10 items-center gap-2 text-sm font-semibold text-o-blue transition-colors hover:text-cyan-700"
      href={url("/")}
    >
      <span aria-hidden="true">←</span>
      Wróć do głosowania
    </a>

    <header class="mb-7 mt-4">
      <p class="text-sm font-bold tracking-wide text-o-blue">
        OMatKo!!! · 2026
      </p>
      <h1 class="text-3xl font-bold tracking-tight text-[color:var(--ink)]">
        Statystyki głosowania
      </h1>
      <p class="mt-1 text-sm text-[color:var(--muted-ink)]">
        Wynik = 6 × średnia z pierwszej kategorii + 4 × średnia z drugiej
        kategorii (maksymalnie 50 punktów). W rankingu uwzględniane są
        prezentacje ocenione w obu kategoriach.
      </p>
    </header>

    <section
      aria-label="Podsumowanie"
      class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4"
    >
      <article class="theme-surface p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-[color:var(--muted-ink)]">
          Głosy
        </p>
        <p class="mt-2 text-2xl font-bold tabular-nums">
          {number(stats.totalVotes)}
        </p>
      </article>
      <article class="theme-surface p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-[color:var(--muted-ink)]">
          Głosujący
        </p>
        <p class="mt-2 text-2xl font-bold tabular-nums">
          {number(stats.participantCount)}
        </p>
      </article>
      <article class="theme-surface p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-[color:var(--muted-ink)]">
          Ocenione
        </p>
        <p class="mt-2 text-2xl font-bold tabular-nums">
          {number(stats.ratedPresentationCount)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted-ink)]">prezentacje</p>
      </article>
      <article class="theme-surface p-4">
        <p class="text-xs font-semibold uppercase tracking-wide text-[color:var(--muted-ink)]">
          Wszystkie
        </p>
        <p class="mt-2 text-2xl font-bold tabular-nums">
          {number(stats.presentationCount)}
        </p>
        <p class="mt-1 text-xs text-[color:var(--muted-ink)]">prezentacje</p>
      </article>
    </section>

    <section aria-labelledby="leaderboards-heading">
      <div class="mb-4">
        <h2
          id="leaderboards-heading"
          class="text-2xl font-semibold text-[color:var(--ink)]"
        >
          Rankingi
        </h2>
        <p class="text-sm text-[color:var(--muted-ink)]">
          Przy remisie wyżej jest prezentacja z większą liczbą oddanych ocen.
        </p>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        {stats.leaderboards.map((leaderboard) => (
          <article class="theme-surface p-5">
            <h3 class="mb-3 text-lg font-semibold">
              {groupLabel[leaderboard.group]}
            </h3>
            {leaderboard.entries.length === 0 ? (
              <p class="rounded-[9px] bg-[var(--hover-tint)] px-3 py-4 text-sm text-[color:var(--muted-ink)]">
                Brak prezentacji ocenionych w obu kategoriach.
              </p>
            ) : (
              <ol class="divide-y divide-zinc-100 dark:divide-zinc-700">
                {leaderboard.entries.map((entry, index) => (
                  <li class="flex items-center gap-3 py-3 first:pt-0 last:pb-0">
                    <span class="w-6 shrink-0 text-sm font-bold tabular-nums text-[color:var(--muted-ink)]">
                      {index + 1}.
                    </span>
                    <div class="min-w-0 flex-1">
                      <a
                        class="block truncate font-semibold text-[color:var(--ink)] underline-offset-4 hover:text-o-blue hover:underline"
                        href={url(`/stats/${entry.presentationId}`)}
                      >
                        {entry.title}
                      </a>
                      <p class="truncate text-sm text-[color:var(--muted-ink)]">
                        {entry.author}
                      </p>
                      <p class="truncate text-xs text-[color:var(--muted-ink)]">
                        {categoryLabel(entry.categoryScores[0].category)}{" "}
                        {entry.categoryScores[0].averageScore.toFixed(2)}·{" "}
                        {categoryLabel(entry.categoryScores[1].category)}{" "}
                        {entry.categoryScores[1].averageScore.toFixed(2)}
                      </p>
                    </div>
                    <div class="shrink-0 text-right">
                      <p class="font-bold tabular-nums">
                        {entry.score.toFixed(2)}
                        <span class="text-xs font-medium text-[color:var(--muted-ink)]">
                          {" "}
                          / 50
                        </span>
                      </p>
                      <p class="text-xs text-[color:var(--muted-ink)]">
                        {number(entry.voteCount)} ocen
                      </p>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>
</Layout>
