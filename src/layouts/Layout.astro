---
import "../styles/global.css";
import { loadSchedule } from "$lib/server/schedule";
import { buildNavigationItems } from "$lib/navigation";
import BottomNav from "../components/BottomNav.svelte";
import LiveStatsSnapshot from "../components/LiveStatsSnapshot.svelte";

interface Props {
  title?: string;
  ballot?: string;
}

const { title = "Głosowanie · OMatKo!!!", ballot: requestedBallot } =
  Astro.props;
const isStatsPage = Astro.url.pathname.startsWith("/stats");
if (isStatsPage)
  Astro.response.headers.set("Cache-Control", "private, no-store");
const ballot = requestedBallot ?? (isStatsPage ? "options" : undefined);
const statsSchedule = isStatsPage ? await loadSchedule() : null;
const statsNavItems = statsSchedule
  ? buildNavigationItems(
      statsSchedule.days.length,
      statsSchedule.posters.length > 0,
      true,
    )
  : [];
---

<!doctype html>
<html lang="pl" data-ballot={ballot}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (localStorage.getItem("omatko-theme") === "dark") {
          document.documentElement.classList.add("dark");
        }
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body
    class:list={["min-h-dvh font-sans antialiased", isStatsPage && "pb-24"]}
  >
    <div class="floating-bg" aria-hidden="true"></div>
    <slot />
    {isStatsPage && <LiveStatsSnapshot client:load />}
    {isStatsPage && (
      <BottomNav client:load items={statsNavItems} initial="options" />
    )}
  </body>
</html>
