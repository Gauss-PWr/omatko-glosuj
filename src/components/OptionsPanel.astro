---
import SettingsPanel from "./SettingsPanel.svelte";

interface Props {
  canViewStats: boolean;
}

const { canViewStats } = Astro.props;
---

<div class="grid w-full gap-4 sm:grid-cols-2">
  <SettingsPanel client:load />
  {canViewStats && (
    <article class="theme-surface w-full rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-700">
      <h2 class="text-lg font-semibold">Statystyki</h2>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
        Podgląd głosów na żywo, rankingi kategorii i szczegółowe wyniki
        prezentacji.
      </p>
      <a
        class="mt-4 inline-flex min-h-10 items-center justify-center rounded-lg bg-o-blue px-4 py-2 text-sm font-bold text-white transition-[background-color,transform] duration-150 hover:bg-cyan-700 active:scale-[0.98]"
        href="/stats"
      >
        Otwórz statystyki
      </a>
    </article>
  )}
</div>
