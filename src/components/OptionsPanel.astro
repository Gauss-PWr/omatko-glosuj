---
import SettingsPanel from "./SettingsPanel.svelte";

interface Props {
  canViewStats: boolean;
}

const { canViewStats } = Astro.props;
---

<div class="grid w-full gap-4 sm:grid-cols-2">
  <SettingsPanel client:load />
  {canViewStats && (
    <article class="theme-surface w-full p-5">
      <h2 class="text-lg font-semibold">Statystyki</h2>
      <p class="mt-2 text-sm text-[color:var(--muted-ink)]">
        Podgląd głosów na żywo, rankingi kategorii i szczegółowe wyniki
        prezentacji.
      </p>
      <a
        class="mt-4 inline-flex min-h-10 items-center justify-center rounded-[15px] bg-o-green px-5 py-2 text-sm font-semibold text-white transition-[filter,transform] duration-150 hover:brightness-95 active:scale-[0.98]"
        href="/stats"
      >
        Otwórz statystyki
      </a>
    </article>
  )}
</div>
