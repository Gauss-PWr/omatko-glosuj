---
import type { SlotCard } from "$lib/server/schedule";
import { formatClock } from "$lib/server/schedule";
import SlotBoard from "./SlotBoard.svelte";

interface Props {
  slotCard: SlotCard;
}

const { slotCard } = Astro.props;
const timeRange = `${formatClock(slotCard.start)} – ${formatClock(slotCard.end)}`;
---

<SlotBoard
  client:load
  slotId={slotCard.id}
  talks={slotCard.talks}
  timeRange={timeRange}
  startMs={slotCard.start.getTime()}
  endMs={slotCard.end.getTime()}
/>
